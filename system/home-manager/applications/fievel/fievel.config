# Fievel (https://github.com/MontyTheSoftwareEngineer/fievel), linked from the
# Nix store: the settings screen cannot save, edit this file instead.
#
# Keys are Linux keycodes, not layout characters. The keyboard sends Colemak-DH
# from its firmware, so every control sits where upstream's QWERTY default
# sits: M/N/E/I move like the Hyprland focus binds, where upstream uses H/J/K/L.
# Omitted settings keep upstream's defaults; no [remap] tables, so typing is
# never delayed.
mode = "hold"

[keys]
# Fievel swallows its shortcuts. Super+Shift+R moves a window to workspace 2.
reload_config = "leftmeta + leftshift + f5"
toggle_hold = "z"
left = "m"
down = "n"
up = "e"
right = "i"
left_click = "space"
right_click = "u"
scroll_left = "k"
scroll_down = "h"
scroll_up = ","
scroll_right = "."
slow = "a"
fast = "r"
locate = "q"

[hints.keys]
# Super+Space toggles Sinhala and Super+I focuses right in Hyprland.
left = "leftmeta + o"
right = "leftmeta + u"
